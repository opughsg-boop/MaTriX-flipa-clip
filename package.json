{
  "name": "flipaforge",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Open-source hand-drawn 2D animation studio for frame-by-frame creation, AI storyboard synthesis, and Codex / Claude Code programmatic video rendering.",
  "keywords": [
    "animation",
    "flipaclip",
    "2d-animation",
    "hand-drawn",
    "codex",
    "claude-code",
    "mcp",
    "gif",
    "mp4"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "render": "tsx cli/render.ts",
    "mcp": "tsx mcp/server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "roughjs": "^4.6.6",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
